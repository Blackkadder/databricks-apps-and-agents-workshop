# ── Required ──────────────────────────────────────────────────────────────────
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_TOKEN=<your-token-or-leave-blank-for-cli-auth>

# ── Model ─────────────────────────────────────────────────────────────────────
DATABRICKS_MODEL=databricks-claude-sonnet-4-6

# ── MLflow Tracing ────────────────────────────────────────────────────────────
MLFLOW_EXPERIMENT_ID=<your-mlflow-experiment-id>
MLFLOW_UC_TRACE_TABLE=<catalog>.<schema>.agent_traces_otel_spans

# ── Prompt Registry ───────────────────────────────────────────────────────────
MLFLOW_PROMPT_NAME=<catalog>.<schema>.system_prompt
MLFLOW_PROMPT_ALIAS=production

# ── Cost (optional — leave unset to emit no cost attributes on traces) ────────
# PRICE_INPUT_PER_M=<input-price-per-million-tokens>
# PRICE_OUTPUT_PER_M=<output-price-per-million-tokens>
