{
  "name": "agent-workshop-mastra",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Mastra (TypeScript) port of the Databricks agent workshop — minimal chat agent against a Databricks Foundation Model endpoint. To be tailored toward Udemy's Altus use case (tracing + eval).",
  "scripts": {
    "chat": "NODE_EXTRA_CA_CERTS=$HOME/.config/corp-ca.pem tsx src/chat.ts",
    "serve": "NODE_EXTRA_CA_CERTS=$HOME/.config/corp-ca.pem tsx src/server.ts",
    "start": "tsx src/server.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "2.0.50",
    "@mastra/core": "1.42.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-proto": "0.205.0",
    "@opentelemetry/resources": "2.1.0",
    "@opentelemetry/sdk-trace-node": "2.1.0",
    "@opentelemetry/semantic-conventions": "1.41.1",
    "dotenv": "latest",
    "tsx": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest"
  }
}
